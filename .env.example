# PostgreSQL connection string.
# Example: postgresql://user:password@host:5432/db
# For Docker Compose, use the db service host: postgresql://postgres:postgres@db:5432/dastyare_social_sh
DATABASE_URL="postgresql://user:password@localhost:9824/db"

# Admin account used by the bootstrap script.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password

# Shared API key used by external clients for protected API routes.
# Send it as: Authorization: Bearer <your-key>
# Generate with: openssl rand -hex 32
API_KEY=replace-with-a-strong-secret

# Better Auth configuration.
# BETTER_AUTH_URL should be your app's public URL.
# BETTER_AUTH_SECRET should be a long random secret.
BETTER_AUTH_URL="http://localhost:2947"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
