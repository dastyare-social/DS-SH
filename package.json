{
  "name": "dastyare-social-sh",
  "version": "0.1.0",
  "description": "Self-hostable short-link service with a dashboard, REST API, OpenAPI docs, and Better Auth.",
  "license": "MIT",
  "author": {
    "name": "Dastyare Social",
    "url": "https://dastyare.social"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omidshabab/sh.dastyare.social.git"
  },
  "homepage": "https://github.com/omidshabab/sh.dastyare.social#readme",
  "bugs": {
    "url": "https://github.com/omidshabab/sh.dastyare.social/issues"
  },
  "keywords": [
    "short-link",
    "url-shortener",
    "nextjs",
    "better-auth",
    "trpc",
    "drizzle",
    "openapi",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "scripts": {
    "dev": "next dev -p 2947",
    "build": "bun run bootstrap:admin && next build",
    "start": "next start -p 2947",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:drop": "drizzle-kit drop",
    "db:pull": "drizzle-kit introspect",
    "db:push": "drizzle-kit push && tsx src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "openapi:generate": "bunx next-openapi-gen generate"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@scalar/api-reference-react": "^0.9.27",
    "@scalar/nextjs-api-reference": "^0.10.10",
    "@scalar/nextjs-openapi": "^0.3.10",
    "@trpc/client": "^11.16.0",
    "@trpc/next": "^11.16.0",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.7.0",
    "next": "16.1.6",
    "next-intl": "^4.9.1",
    "nextjs-toploader": "^3.9.17",
    "pg": "^8.20.0",
    "postgres": "^3.4.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
